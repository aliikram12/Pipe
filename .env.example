# Database configuration
# By default, uses SQLite for instant local zero-config testing.
# For production (PostgreSQL), change provider in schema.prisma and use postgres connection string:
# DATABASE_URL="postgresql://username:password@ep-host.region.aws.neon.tech/agrisupply?sslmode=require"
DATABASE_URL="file:./dev.db"

# JWT Authentication Secrets
JWT_SECRET="agrisupply-production-jwt-access-secret-key-xyz-2026"
JWT_REFRESH_SECRET="agrisupply-production-jwt-refresh-secret-key-xyz-2026"

# URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="/api"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"
NEXT_PUBLIC_MAP_API_URL="https://nominatim.openstreetmap.org"
