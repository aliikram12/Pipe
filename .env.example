# Database configuration
# For production (PostgreSQL on Neon/Supabase/Vercel Postgres):
DATABASE_URL="postgresql://username:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://username:password@host/dbname?sslmode=require"

# JWT Authentication Secrets (generate strong random strings)
JWT_SECRET="your-jwt-access-secret-key"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key"

# URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="/api"
NEXT_PUBLIC_MAP_API_URL="https://nominatim.openstreetmap.org"

# Mapbox (for Fleet GPS Tracking Map)
NEXT_PUBLIC_MAPBOX_TOKEN="your-mapbox-public-token"

# Weather API (weatherapi.com)
NEXT_PUBLIC_WEATHER_API_KEY="your-weather-api-key"
